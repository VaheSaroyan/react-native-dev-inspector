{
  "name": "@rn-dev-inspector/rn-compat",
  "version": "1.2.0",
  "description": "React Native version compatibility layer for React Native Dev Inspector - Metro resolver shim that rebuilds the inspector hierarchy on Fabric (RN 0.73+/0.86+)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "shims"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "inspector",
    "devtools",
    "metro",
    "fabric",
    "compat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaheSaroyan/react-native-dev-inspector.git",
    "directory": "packages/rn-compat"
  },
  "bugs": {
    "url": "https://github.com/VaheSaroyan/react-native-dev-inspector/issues"
  },
  "homepage": "https://github.com/VaheSaroyan/react-native-dev-inspector#readme",
  "devDependencies": {
    "@types/node": "^20.10.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime.js",
    "./runtime.js": "./dist/runtime.js"
  }
}
